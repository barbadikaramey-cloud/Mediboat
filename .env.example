# ─────────────────────────────────────────────────────────────────────────────
# MediBot — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq API ──────────────────────────────────────────────────────────────────
# Free tier at https://console.groq.com
GROQ_API_KEY=gsk_...

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
# Free 1 GB cluster at https://cloud.qdrant.io
QDRANT_URL=https://<cluster-id>.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=...

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Free tier at https://upstash.com (REST endpoint)
UPSTASH_REDIS_URL=https://<db-name>.upstash.io
UPSTASH_REDIS_TOKEN=...
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ── Observability: Logfire ────────────────────────────────────────────────────
# Free tier at https://logfire.pydantic.dev
LOGFIRE_TOKEN=...
LOGFIRE_SEND_TO_LOGFIRE=true

# ── Observability: LangSmith ──────────────────────────────────────────────────
# Free tier at https://smith.langchain.com
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=medibot

# ── Local paths (usually no change needed) ────────────────────────────────────
SQLITE_DB_PATH=data/mediassist.db
QDRANT_COLLECTION=medibot
MODEL_GENERATION=openai/gpt-oss-120b
MODEL_CHEAP=openai/gpt-oss-20b
